              }
            }
          ]
        },
        {
          "ruleId": "stray-colors",
          "level": "note",
          "message": {
            "text": "5 hardcoded colour values no token names."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "styles/main.css"
                }
              }
            }
          ]
        },
        {
          "ruleId": "stale-rule-reference",
          "level": "warning",
          "message": {
            "text": "src/components/OldThing.tsx is referenced here but no longer exists in the repo."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "CLAUDE.md"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}